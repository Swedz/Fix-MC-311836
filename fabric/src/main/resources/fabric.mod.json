{
    "schemaVersion": 1,
    "id": "${mod_id}",
    "version": "${mod_version}",
    "name": "${mod_name}",
    "description": "${mod_description}",
    "authors": [
        "${mod_authors}"
    ],
    "contact": {
        "homepage": "${mod_github}",
        "sources": "${mod_github}"
    },
    "license": "MIT",
    "environment": "*",
    "entrypoints": {
        "main": [
            "net.swedz.my_mod.fabric.MyModFabric"
        ],
        "server": [],
        "client": [
            "net.swedz.my_mod.fabric.client.MyModFabricClient"
        ]
    },
    "mixins": [
        "${mod_id}.common.mixins.json",
        "${mod_id}.fabric.mixins.json"
    ],
    "accessWidener": "${mod_id}.fabric.accesswidener.classtweaker",
    "depends": {
        "fabricloader": ">=${fabric_version}",
        "minecraft": "~${minecraft_version}",
        "java": ">=25",
        "fabric-api": "*"
    }
}